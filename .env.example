# Copy this file to .env.local and fill in real values.

# --- Database: Neon Postgres ---
# Create a project at https://neon.tech, then copy the POOLED connection string
# (it contains "-pooler" in the host). Used by Drizzle + drizzle-kit + the seed.
DATABASE_URL=

# --- Auth: Clerk (admin dashboard only — the storefront is public) ---
# Create an application at https://dashboard.clerk.com and copy these from "API Keys".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where Clerk's sign-in / sign-up pages live (these match the app routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

# --- Admin allowlist ---
# Comma-separated emails allowed into /admin. The signed-in Clerk user's
# verified email must match one of these.
ADMIN_EMAILS=you@example.com

# --- Payments (optional — "manual" works with no keys) ---
# PAYMENT_PROVIDER=manual
# PAYONEER_API_KEY=
# PAYONEER_WEBHOOK_SECRET=
