# Copy this file to .env.local and fill in real values.

# --- Database: Neon Postgres ---
# Create a project at https://neon.tech, then copy the POOLED connection string
# (it contains "-pooler" in the host). Used by Drizzle + drizzle-kit + the seed.
DATABASE_URL=

# --- Auth: Clerk (admin dashboard only — the storefront is public) ---
# Create an application at https://dashboard.clerk.com and copy these from "API Keys".
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Where Clerk's sign-in / sign-up pages live (these match the app routes).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/admin
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/admin

# --- Admin allowlist ---
# Comma-separated emails allowed into /admin. The signed-in Clerk user's
# verified email must match one of these.
ADMIN_EMAILS=you@example.com

# --- Payments (optional — "manual" works with no keys) ---
# PAYMENT_PROVIDER=manual
# PAYONEER_API_KEY=
# PAYONEER_WEBHOOK_SECRET=

# --- Canonical URL (SEO / OG / sitemap) ---
# Your production origin, e.g. https://posted.studio. Falls back to a demo origin.
SITE_URL=
# NEXT_PUBLIC_SITE_URL=   # same value, if you need it client-side

# --- Transactional email (Resend) — OPTIONAL ---
# Create a key at https://resend.com. When unset, order/contact emails are
# logged to the server console and skipped (no crash).
RESEND_API_KEY=
EMAIL_FROM="Posted. <orders@yourdomain.com>"

# --- Payments: Payoneer — OPTIONAL ---
# Until PAYMENT_PROVIDER=payoneer AND these are set, checkout uses the manual
# pending-payment flow. Set all three to activate Payoneer with no code change.
# PAYMENT_PROVIDER=payoneer
# PAYONEER_API_KEY=
# PAYONEER_API_BASE=https://api.payoneer.com
# PAYONEER_WEBHOOK_SECRET=   # used to verify the payment webhook signature

# --- Analytics: Plausible (privacy-friendly) — OPTIONAL ---
# Your site domain registered in Plausible, e.g. posted.studio. No-op if unset.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Error monitoring: Sentry — OPTIONAL ---
# Project DSN from https://sentry.io. No-op if unset.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
